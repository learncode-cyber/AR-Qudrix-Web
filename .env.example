# =============================================================================
# AR QUDRIX — Environment Variables Template
# Copy to .env (root, gitignored) and fill in real values per environment
# (development / staging / production). NEVER commit real secrets.
# =============================================================================

# --- Database (Neon PostgreSQL — external managed, works from Hostinger) ------
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/arqudrix?sslmode=require"

# --- Auth.js -------------------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://arqudrix.com"
AUTH_TRUST_HOST="true"

# --- ARQ OS Integration (server-side only — NEVER exposed to the browser) ------
ARQ_OS_API_BASE_URL="https://os.arqudrix.com/api"
ARQ_OS_SERVICE_CLIENT_ID=""
ARQ_OS_SERVICE_CLIENT_SECRET=""

# --- App URLs --------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://arqudrix.com"
NEXT_PUBLIC_ADMIN_URL="https://arqudrix.com/admin"

# --- Admin panel path (security through obscurity) -----------------------------
# The word "admin" does not have to appear anywhere in your live URLs. Set
# this to any private path segment you choose, e.g. "control-x9k2" — the
# admin panel then lives at https://arqudrix.com/control-x9k2 instead, and
# the literal /admin path stops working entirely (returns a normal 404).
# Leave blank/unset to keep the default "/admin". This is a NEXT_PUBLIC_
# variable, so changing it requires a rebuild + redeploy, not just a
# server restart — see README "Admin panel path" for details.
NEXT_PUBLIC_ADMIN_PATH_SEGMENT=""

# --- Observability -----------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""

# --- Advertising / Analytics pixels -----------------------------------------
# Meta Pixel and Google Ads are configured at runtime from your admin
# panel's Integrations page, not here. They are stored in the
# IntegrationSettings table so marketing can rotate IDs or toggle
# platforms on/off without a code change or redeploy.

# --- Media / Storage (S3-compatible — e.g. Cloudflare R2) ---------------------
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
